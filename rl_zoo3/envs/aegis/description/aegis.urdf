    <origin rpy="0.00032553104069531707 0.0010874853653533936 4.031572309499588e-06" xyz="-0.3921255601222307 -4.3708049656647096e-05 0.1342669135925358"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.5699928967694992 0 7.029186154736133e-07" xyz="2.7085045692519178e-05 -0.09974184937390201 8.013561381817232e-05"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.5708376341510673 3.141592653589793 -3.1415926085142813" xyz="5.3852868760516236e-05 0.0994662662919303 4.108688491032879e-06"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <joint name="adapter_to_sensor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="tool0"/>
    <child link="adapter_to_sensor"/>
  </joint>
  <link name="adapter_to_sensor">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0058"/>
      <geometry>
        <cylinder length="0.0116" radius="0.03025"/>
      </geometry>
      <material name="black">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0163"/>
      <geometry>
        <cylinder length="0.0094" radius="0.04255"/>
      </geometry>
      <material name="black">
        <color rgba="0.04 0.04 0.04 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.242"/>
      <inertia ixx="0.00016939216807643898" ixy="0.0" ixz="0.0" iyy="0.00016939216807643898" iyz="0.0" izz="0.00032979336499999994"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.010499999999999999"/>
      <geometry>
        <cylinder length="0.020999999999999998" radius="0.04255"/>
      </geometry>
    </collision>
  </link>
  <joint name="adapter_to_sensor_end_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.020999999999999998"/>
    <parent link="adapter_to_sensor"/>
    <child link="adapter_to_sensor_end"/>
  </joint>
  <link name="adapter_to_sensor_end"/>
  <joint name="fts_joint" type="fixed">
    <!-- The parent link must be read from the robot model it is attached to. -->
    <parent link="adapter_to_sensor_end"/>
    <child link="fts_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="fts_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ati_axia80_ft_sensor.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ati_axia80_ft_sensor.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.29900000000000004"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0005186940291889721" ixy="0.0" ixz="0.0" iyy="0.0005186940291889721" iyz="0.0" izz="0.0010052380000000003"/>
    </inertial>
  </link>
  <joint name="tool_side_joint" type="fixed">
    <parent link="fts_link"/>
    <child link="tool_mount_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0254"/>
  </joint>
  <link name="tool_mount_link"/>
  <joint name="adapter_from_sensor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.0119"/>
    <parent link="tool_mount_link"/>
    <child link="adapter_from_sensor"/>
  </joint>
  <link name="adapter_from_sensor">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/adapter_from_sensor.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.217"/>
      <inertia ixx="0.000148470617278396" ixy="0.0" ixz="0.0" iyy="0.000148470617278396" iyz="0.0" izz="0.00029004762500000003"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.0189" radius="0.041"/>
      </geometry>
    </collision>
  </link>
  <joint name="adapter_from_sensor_end_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.007"/>
    <parent link="adapter_from_sensor"/>
    <child link="adapter_from_sensor_end"/>
  </joint>
  <link name="adapter_from_sensor_end"/>
  <ros2_control name="robotiq_hande_gripper" type="system">
    <hardware>
      <plugin>robotiq_hande_driver/RobotiqHandeHardwareInterface</plugin>
      <param name="grip_pos_min">0</param>
      <param name="grip_pos_max">0.025</param>
      <param name="tty">/tmp/ttyUR</param>
      <param name="baudrate">115200</param>
      <param name="parity">N</param>
      <param name="data_bits">8</param>
      <param name="stop_bit">1</param>
      <param name="slave_id">9</param>
    </hardware>
    <!-- The right finger joint uses the mimic feature -->
    <joint name="robotiq_hande_left_finger_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">0.025</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.025</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0</param>
      </state_interface>
    </joint>
  </ros2_control>
  <!-- Robotiq Coupler -->
  <!--  + Height added by the coupler (13.9mm) -->
  <!--  + Reference frame at the middle (6.95mm) -->
  <joint name="robotiq_hande_coupler_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0 0 0.00695"/>
    <parent link="adapter_from_sensor_end"/>
    <child link="robotiq_hande_coupler"/>
  </joint>
  <link name="robotiq_hande_coupler">
    <inertial>
      <mass value="0.168"/>
      <inertia ixx="6.17674E-05" ixy="0.0" ixz="0.0" iyy="6.17674E-05" iyz="0.0" izz="1.18125E-04"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.0139" radius="0.0375"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <mesh filename="meshes/coupler.dae"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>
  </link>
  <joint name="robotiq_hande_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.055"/>
    <parent link="robotiq_hande_coupler"/>
    <child link="robotiq_hande_link"/>
  </joint>
  <link name="robotiq_hande_link">
    <inertial>
      <mass value="0.86387"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0006"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.0988" radius="0.0375"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 -1.570796 -1.570796" xyz="0 0 -0.0016"/>
      <geometry>
        <mesh filename="meshes/hande.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="DarkGrey"/>
    </visual>
  </link>
  <joint name="robotiq_hande_left_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 -0.025 0.0345"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_left_finger"/>
    <axis xyz="0 1 0"/>
    <limit effort="130" lower="0" upper="0.025" velocity="0.15"/>
  </joint>
  <link name="robotiq_hande_left_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03804"/>
      <inertia ixx="1E-9" ixy="0.0" ixz="0.0" iyy="1E-9" iyz="0.0" izz="1E-9"/>
    </inertial>
    <collision>
      <origin rpy="0 0 3.1415926" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/finger_collision.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="1.570796 0 3.1415926" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/finger.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="Grey"/>
    </visual>
  </link>
  <joint name="robotiq_hande_right_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0.025 0.0345"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_right_finger"/>
    <axis xyz="0 -1 0"/>
    <limit effort="130" lower="0" upper="0.025" velocity="0.15"/>
    <mimic joint="robotiq_hande_left_finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="robotiq_hande_right_finger">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03804"/>
      <inertia ixx="1E-9" ixy="0.0" ixz="0.0" iyy="1E-9" iyz="0.0" izz="1E-9"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/finger_collision.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/finger.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="Grey"/>
    </visual>
  </link>
  <joint name="robotiq_hande_end_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.095"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_end"/>
  </joint>
  <link name="robotiq_hande_end"/>
</robot>
